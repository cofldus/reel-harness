# Reel Harness configuration (pydantic-settings reads .env in the CWD).
# Copy to .env and fill in real values. NEVER commit .env -- it is gitignored.
# Every value below is a placeholder, not a real credential.

# --- Core ---
DATABASE_URL=sqlite:///./reel_harness.db
JOBS_DIR=./jobs
APP_API_KEY=replace-with-a-long-random-local-api-key
LOG_LEVEL=INFO

# --- Worker lease policy ---
# Heartbeat must stay well below the timeout (<= 1/3) so long renders are
# never reclaimed as stale.
LEASE_TIMEOUT_SECONDS=300
LEASE_HEARTBEAT_SECONDS=60

# --- Worker daemon (reel-harness worker-run) defaults; CLI flags override ---
WORKER_POLL_INTERVAL_SECONDS=5.0
# WORKER_IDLE_EXIT_AFTER_SECONDS=
# WORKER_MAX_JOBS=
WORKER_STOP_ON_ERROR=false

# --- LLM provider ---
# "fake" (default, no network) or "openai_compatible" (any /chat/completions
# endpoint -- the vendor is chosen purely by base URL + model). Selecting
# openai_compatible without base URL/model/API key fails clearly at startup.
REEL_HARNESS_LLM_PROVIDER=fake
REEL_HARNESS_LLM_BASE_URL=
REEL_HARNESS_LLM_MODEL=
# Read from the environment/.env only; shown as ********** in config repr,
# registered for log/DB redaction at startup, never persisted anywhere.
REEL_HARNESS_LLM_API_KEY=
REEL_HARNESS_LLM_CONNECT_TIMEOUT=10.0
REEL_HARNESS_LLM_READ_TIMEOUT=60.0
REEL_HARNESS_LLM_MAX_RETRIES=3
REEL_HARNESS_LLM_RETRY_BACKOFF=2.0
REEL_HARNESS_LLM_TEMPERATURE=0.7
REEL_HARNESS_LLM_MAX_OUTPUT_TOKENS=1200

# --- Media toolchain (optional overrides; see docs/ARCHITECTURE.md) ---
# REEL_HARNESS_FFMPEG_PATH=
# REEL_HARNESS_FFPROBE_PATH=
